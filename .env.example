# Server
SERVER_PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root123
DB_DATABASE=ebap

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# Default Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# University Electric API
ELECTRIC_API_BASE_URL=http://example.com/api
ELECTRIC_API_LIGHT_PATH=/electric/light?openId={openId}
ELECTRIC_API_AIR_PATH=/electric/air?openId={openId}
ELECTRIC_API_TIMEOUT=10000

# SMTP Email
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=noreply@example.com
MAIL_PASS=your-smtp-password
MAIL_FROM=noreply@example.com

# Schedule
ELECTRIC_FETCH_CRON=0 * * * *